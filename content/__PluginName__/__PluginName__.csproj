<Project>
  <!--
    ============================================================================
    __PluginName__ — Node.aec-licensed Autodesk Revit plugin (dotnet-new template).

    Revit-year matrix:
      2023 | 2024 -> net48
      2025 | 2026 -> net8.0-windows   (2026 targets net8 on purpose: a net8
                                        add-in loads in the 2026.5 net10 host
                                        and in 2026.0-2026.4)
      2027        -> net10.0-windows

    Build:
      dotnet build -p:RevitYear=2026   # default
      dotnet build -p:RevitYear=2023   # net48
      dotnet build -p:RevitYear=2027   # net10

    LICENSING (frozen contract NodeAec.Licensing.Gate):
      NodeAec.Licensing.Lite is referenced via PackageReference — the
      verification code is compiled INTO this plugin, so the build needs nothing
      beyond the restored packages. The only seam is Licensing/NodeAecLicenseGate.cs:
      Gate.Validate(ProductSlug) as the first statement of every command,
      branching only on IsLicensed.

    This project uses the explicit SDK-import form (Sdk.props / Sdk.targets); the
    Project element carries no Sdk attribute. The matrix above is therefore
    evaluated BEFORE the SDK is imported. BaseIntermediateOutputPath MUST be set
    that early; keep the imports if you edit this file.
    ============================================================================
  -->
  <PropertyGroup>
    <RevitYear Condition="'$(RevitYear)' == ''">2026</RevitYear>

    <!-- Nice3point Revit API packages: one pinned version per Revit year. -->
    <RevitApiPkgVersion Condition="'$(RevitYear)' == '2023'">2023.1.90</RevitApiPkgVersion>
    <RevitApiPkgVersion Condition="'$(RevitYear)' == '2024'">2024.3.60</RevitApiPkgVersion>
    <RevitApiPkgVersion Condition="'$(RevitYear)' == '2025'">2025.4.60</RevitApiPkgVersion>
    <RevitApiPkgVersion Condition="'$(RevitYear)' == '2026'">2026.4.10</RevitApiPkgVersion>
    <RevitApiPkgVersion Condition="'$(RevitYear)' == '2027'">2027.2.0</RevitApiPkgVersion>

    <!-- TFM per Revit year (see rationale in the header comment). -->
    <TargetFramework Condition="'$(RevitYear)' == '2023' or '$(RevitYear)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitYear)' == '2025' or '$(RevitYear)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitYear)' == '2027'">net10.0-windows</TargetFramework>

    <!-- Year constant for #if REVIT2023..REVIT2027 source guards. -->
    <DefineConstants>REVIT$(RevitYear);$(DefineConstants)</DefineConstants>

    <!--
      .NET Framework reference assemblies are nullable-oblivious: guards such as
      string.IsNullOrEmpty(...) carry no [NotNullWhen] annotation, so proven-safe
      dereferences still report CS8602/CS8603/CS8604 — only on net48, where the
      code compiles warning-free on net8/net10 with the same source. False
      positives, suppressed for net48 only.
    -->
    <NoWarn Condition="'$(TargetFramework)' == 'net48'">$(NoWarn);CS8602;CS8603;CS8604</NoWarn>

    <!-- Isolate intermediate/output folders per Revit year so looped builds never overwrite each other. -->
    <BaseIntermediateOutputPath>obj\$(RevitYear)\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\$(RevitYear)\</BaseOutputPath>
    <!-- Once a second year has been built, sibling obj\2024\, obj\2025\, ... folders must not
         leak into the default **/*.cs Compile glob (duplicate AssemblyInfo attributes, CS0579). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>__PluginName__</RootNamespace>
    <AssemblyName>__PluginName__</AssemblyName>
    <Version>0.1</Version>
    <Description>__PluginName__ — Node.aec-licensed plugin for Autodesk Revit.</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Autodesk.Windows (AdWindows) surfaces WPF types (ribbon icons). -->
    <UseWPF>true</UseWPF>
    <!-- Dependency DLLs (not RevitAPI) travel with the add-in — including the Lite licensing assembly. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit API assemblies are provided by Revit at runtime: reference-only, never copied. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPkgVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPkgVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitApiPkgVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Offline license verification, compiled into this plugin via NuGet. -->
    <PackageReference Include="NodeAec.Licensing.Lite" Version="1.0.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the manifest with the payload: packaging drops this file at
         <year>\__PluginName__.addin and the DLL at <year>\__PluginName__\__PluginName__.dll
         (the relative Assembly path inside the manifest assumes exactly that layout). -->
    <None Update="__PluginName__.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
