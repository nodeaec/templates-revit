{
  "$schema": "http://json.schemastore.org/template",
  "author": "Node.aec",
  "classifications": [
    "Revit",
    "NodeAec"
  ],
  "identity": "NodeAec.Templates.RevitPlugin",
  "groupIdentity": "NodeAec.RevitPlugin",
  "name": "Node.aec Revit Plugin (Licensing Lite)",
  "description": "Autodesk Revit add-in with Node.aec offline license verification built in (shared Node.aec tab, fail-closed gate, RevitYear matrix 2023-2027, one .bundle + one installer for every Revit year).",
  "shortName": "nodeaec-revit-plugin",
  "type": "project",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "__PluginName__",
  "preferNameDirectory": true,
  "defaultName": "MyRevitPlugin",
  "primaryOutputs": [
    {
      "path": "__PluginName__.csproj"
    }
  ],
  "symbols": {
    "ProductSlug": {
      "type": "parameter",
      "dataType": "string",
      "replaces": "__ProductSlug__",
      "defaultValue": "my-revit-plugin",
      "description": "Product slug in the Node.aec catalog (used by Gate.Validate; must match the entitlement claim)."
    },
    "AddInId": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "",
      "description": "GUID for <AddInId> in the .addin manifest. Leave empty to get a fresh one (recommended); never reuse another add-in's value."
    },
    "AppId": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "",
      "description": "Installer GUID (Windows Settings > Apps entry), one per product. Leave empty to get a fresh one."
    },
    "NewAddInId": {
      "type": "generated",
      "generator": "guid",
      "parameters": {
        "defaultFormat": "D"
      }
    },
    "NewAppId": {
      "type": "generated",
      "generator": "guid",
      "parameters": {
        "defaultFormat": "D"
      }
    },
    "AddInIdValue": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "AddInId",
        "fallbackVariableName": "NewAddInId"
      },
      "replaces": "__AddInId__"
    },
    "AppIdValue": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "AppId",
        "fallbackVariableName": "NewAppId"
      },
      "replaces": "__AppId__"
    },
    "NewProductCode": {
      "type": "generated",
      "generator": "guid",
      "replaces": "__ProductCode__",
      "parameters": {
        "defaultFormat": "D"
      }
    },
    "NewUpgradeCode": {
      "type": "generated",
      "generator": "guid",
      "replaces": "__UpgradeCode__",
      "parameters": {
        "defaultFormat": "D"
      }
    }
  }
}
